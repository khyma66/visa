{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "visaflow",
  "compatibility_date": "2026-09-09",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "vars": {
    "COMMUNITY_SOURCE_MODE": "snapshot",
    "APIFY_RUN_ID": "9iVj9RajtVcIVkzgZ",
    "APIFY_ACTOR_ID": "2chN8UQcH1CfxLRNE",
    "APIFY_USE_LATEST_RUN": "true",
    "APIFY_API_BASE_URL": "https://api.apify.com/v2"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1
    }
  },
  "main": "vinext/server/fetch-handler",
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "cache": {
    "enabled": true
  },
  "ratelimits": [
    {"name":"SECURITY_READ_LIMIT","namespace_id":"6501401","simple":{"limit":300,"period":60}},
    {"name":"SECURITY_ARCHIVE_LIMIT","namespace_id":"6501402","simple":{"limit":12,"period":60}},
    {"name":"SECURITY_EVENT_SAMPLE","namespace_id":"6501403","simple":{"limit":1,"period":60}},
    {"name":"SECURITY_EVENT_BUDGET","namespace_id":"6501404","simple":{"limit":60,"period":60}}
  ],
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "env": {
    "development": {
      "name": "visaflow-dev",
      "ratelimits": [
        {"name":"SECURITY_READ_LIMIT","namespace_id":"6501411","simple":{"limit":300,"period":60}},
        {"name":"SECURITY_ARCHIVE_LIMIT","namespace_id":"6501412","simple":{"limit":12,"period":60}},
        {"name":"SECURITY_EVENT_SAMPLE","namespace_id":"6501413","simple":{"limit":1,"period":60}},
        {"name":"SECURITY_EVENT_BUDGET","namespace_id":"6501414","simple":{"limit":60,"period":60}}
      ],
      "workers_dev": true,
      "routes": [
        {
          "pattern": "visathreads.com",
          "custom_domain": true
        },
        {
          "pattern": "www.visathreads.com",
          "custom_domain": true
        }
      ],
      "vars": {
        "APP_ENV": "development",
        "COMMUNITY_SOURCE_MODE": "snapshot",
        "APIFY_RUN_ID": "9iVj9RajtVcIVkzgZ",
        "APIFY_ACTOR_ID": "2chN8UQcH1CfxLRNE",
        "APIFY_USE_LATEST_RUN": "true",
        "APIFY_API_BASE_URL": "https://api.apify.com/v2"
      },
      "version_metadata": {
        "binding": "CF_VERSION_METADATA"
      }
    },
    "production": {
      "name": "visaflow",
      "ratelimits": [
        {"name":"SECURITY_READ_LIMIT","namespace_id":"6501421","simple":{"limit":300,"period":60}},
        {"name":"SECURITY_ARCHIVE_LIMIT","namespace_id":"6501422","simple":{"limit":12,"period":60}},
        {"name":"SECURITY_EVENT_SAMPLE","namespace_id":"6501423","simple":{"limit":1,"period":60}},
        {"name":"SECURITY_EVENT_BUDGET","namespace_id":"6501424","simple":{"limit":60,"period":60}}
      ],
      "workers_dev": true,
      "vars": {
        "APP_ENV": "production",
        "PUBLIC_LAUNCH_APPROVED": "false",
        "IMPORTED_CONTENT_APPROVED": "false"
      },
      "version_metadata": {
        "binding": "CF_VERSION_METADATA"
      }
    },
    "sandbox": {
      "name": "visathreads-sandbox",
      "ratelimits": [
        {"name":"SECURITY_READ_LIMIT","namespace_id":"6501431","simple":{"limit":300,"period":60}},
        {"name":"SECURITY_ARCHIVE_LIMIT","namespace_id":"6501432","simple":{"limit":12,"period":60}},
        {"name":"SECURITY_EVENT_SAMPLE","namespace_id":"6501433","simple":{"limit":1,"period":60}},
        {"name":"SECURITY_EVENT_BUDGET","namespace_id":"6501434","simple":{"limit":60,"period":60}}
      ],
      "workers_dev": false,
      "routes": [
        {
          "pattern": "visa-central.com",
          "custom_domain": true
        },
        {
          "pattern": "www.visa-central.com",
          "custom_domain": true
        }
      ],
      "vars": {
        "APP_ENV": "development",
        "COMMUNITY_SOURCE_MODE": "snapshot",
        "APIFY_LIVE_FETCH_ENABLED": "false",
        "ASSISTANT_ENABLED": "false",
        "ASSISTANT_COMMUNITIES_ENABLED": "false",
        "ASSISTANT_CATCHUP_ENABLED": "false",
        "NEXT_PUBLIC_SITE_URL": "https://visa-central.com",
        "NEXT_PUBLIC_SUPABASE_URL": "https://ppdwysmeistjxzjpmxyk.supabase.co",
        "NEXT_PUBLIC_DEPLOYMENT_TARGET": "development-sandbox"
      },
      "version_metadata": {
        "binding": "CF_VERSION_METADATA"
      }
    }
  }
}

# Browser-safe Supabase settings. Find these in Project Settings > API.
# After activating a custom auth domain, use its HTTPS origin here and rebuild.
# See docs/LOGIN_BRANDING_AND_DEPLOYMENT_2026-10-07.md for the ordered cutover.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
NEXT_PUBLIC_APP_ENV=development
# For production, use an ignored .env.production.local with NEXT_PUBLIC_APP_ENV=production
# and the approved public origin. Never mark the release review verified without evidence.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Never place a Supabase secret/service-role key in a NEXT_PUBLIC variable.
# The community MVP does not need a service-role key in the Next.js app.

# Server-only. Google News RSS feed terms restrict reuse to personal/non-commercial
# feed readers. Leave disabled for public deployment until permission is verified.
# Disabled News still links directly to Google News. Never prefix with NEXT_PUBLIC_.
GOOGLE_NEWS_RSS_ENABLED=false

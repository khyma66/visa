# Browser-safe Supabase configuration only. Never use a service-role key here.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
# Enable only after the provider and exact callback URLs are configured.
NEXT_PUBLIC_AUTH_GOOGLE_ENABLED=false
# Public widget key; its secret belongs only in Supabase Auth CAPTCHA settings.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Server-only integrations; provision through deployment secrets, never Git.
SUPABASE_SERVICE_KEY=
CF_ACCOUNT_ID=
CF_R2_ACCESS_KEY_ID=
CF_R2_ACCESS_KEY_SECRET=
CF_R2_BUCKET_NAME=
WORKER_URL=
WORKER_SECRET=
CF_API_TOKEN=
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_API_KEY=
